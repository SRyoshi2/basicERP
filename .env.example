# Von scripts/install-windows.ps1 oder scripts/install-ubuntu.sh erzeugen lassen.
COMPOSE_PROJECT_NAME=basicerp
APP_DOMAIN=localhost
APP_PUBLIC_SCHEME=http
APP_HTTP_PORT=8080
APP_TIME_ZONE=Europe/Berlin
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8080
POSTGRES_DB=basicerp
POSTGRES_USER=basicerp
POSTGRES_PASSWORD=replace-with-a-random-value
DATABASE_URL=postgresql://basicerp:replace-with-a-random-value@db:5432/basicerp
REDIS_URL=redis://redis:6379/0
